#!/bin/sh
#
# Load the SigmaStar MI kernel modules.
#
# WHY S20
#
# The constraint is that the MI modules are in and /dev/mi_* exists before
# anything opens the HAL. thingino installs Raptor at S31raptor, so loading at
# S20 is in front of it with room to spare -- and stays correct if a streamer
# is added to this board later, which is the point of picking it now rather
# than the first time something needs it.
#
# OpenIPC solves the same ordering the other way round: its module load lives
# in S70vendor, so it has to rename upstream's S31raptor to S95raptor to get
# behind it. That rename is forced by *OpenIPC's* init layout, not by anything
# about this hardware, and reproducing it would cost an edit to
# thingino-raptor.mk's install path plus a patch to
# thingino-agent-adapter-raptor, which hardcodes /etc/init.d/S31raptor in its
# detection probe and its streamer-restart action. Loading early leaves both
# untouched.
#
# S20 is safe this early because:
#   - CONFIG_DEVTMPFS_MOUNT=y, so /dev is populated by the kernel and does not
#     wait on mdev. The one node devtmpfs does not create, /dev/mi_poll, is
#     mknod'd by load_sigmastar itself.
#   - S30mdev only runs `mdev -s` and sets the hotplug helper; it does not
#     remount /dev, so the node created here survives it.
#
# On this board there is no streamer yet, so nothing consumes the modules at
# boot. They are loaded anyway because that is what makes the sensor probe
# work: load_sigmastar inserts mi_sensor, and the i2c probe behind
# `sensor`/ipcinfo has nothing to talk to without it.

case "$1" in
	start)
		echo -c 15 "Loading SigmaStar vendor modules"
		load_sigmastar -i
		;;

	stop)
		# Deliberately a no-op. Unloading the MI stack in reverse is not
		# reliable while anything still holds a buffer, and the only caller
		# is shutdown, where the reboot does it properly.
		true
		;;

	restart)
		load_sigmastar -i
		;;

	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
