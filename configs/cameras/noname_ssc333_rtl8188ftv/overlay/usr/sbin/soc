#!/bin/sh
#
# SigmaStar replacement for thingino-system's `soc`, Infinity6B0 variant.
#
# The stock helper reads Ingenic identification registers with devmem
# (0x1300002C, 0x13540231, 0x13540238, 0x13540250, 0x1354021C and four serial
# words at 0x135402xx). None of those addresses is inside the Infinity6 RIU
# window, so on this SoC every one of them takes an external abort:
#
#   Unhandled fault: external abort on non-linefetch (0x008) at 0xb6eb8200
#
# STRICT_DEVMEM is off, so nothing stops the reads -- they fault rather than
# fail. S04hostname, S48webui-config and S96onvif_discovery each invoke this,
# so that is once per caller per boot.
#
# This replacement uses no devmem at all. Everything it reports comes from
# /etc/os-release (stamped at build time by scripts/rootfs_script.sh), from
# procfs, or from ipcinfo.
#
# Camera overlay rather than a package: Makefile:598 appends the camera overlay
# to BR2_ROOTFS_OVERLAY, and overlays are applied at buildroot/Makefile:809 --
# after the per-package rsync at :758 and after TARGET_FINALIZE_HOOKS at :759.
# So this reliably wins over thingino-system's copy. Installing it from a
# package instead would put it into the same last-writer-wins race that dropped
# the agent block from /etc/thingino.json, and thingino-system sorts after
# sigmastar-*, so it would lose.
#
# This is the second copy of this file in the tree, differing from the
# Infinity6E one in the model constant and in print_serial_number. Promote both
# to a shared SigmaStar overlay once the serial question below is settled --
# doing it now would mean designing the shared version around an unknown.

# Overridable so the parsing can be exercised off-target.
OS_RELEASE="${OS_RELEASE:-/etc/os-release}"

os_release_value() {
	[ -r "$OS_RELEASE" ] || return 0
	sed -rn "s/^$1=\"?([^\"]*)\"?$/\1/p" "$OS_RELEASE" | head -n1
}

# ipcinfo -c cannot supply this: sstar_detect_cpu() maps both INFINITY6B and
# INFINITY6E to the string "SSC33X" (ipctool src/hal/sstar.c), so it is a
# generation, not a model. This overlay is board-scoped by construction, so the
# model is stated here.
print_soc_model() {
	echo "ssc333"
}

# Build-stamped, so it tracks the defconfig rather than being repeated here.
print_soc_family() {
	family=$(os_release_value SOC)
	[ -n "$family" ] || family="infinity6b0"
	echo "$family"
}

print_soc_architecture() {
	arch=$(os_release_value ARCHITECTURE)
	[ -n "$arch" ] || arch=$(uname -m)
	echo "$arch"
}

print_soc_clocks() {
	freq=""
	for f in /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_cur_freq \
		/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq; do
		[ -r "$f" ] && freq=$(cat "$f" 2>/dev/null) && break
	done
	if [ -n "$freq" ]; then
		echo "CPU Speed: $((freq / 1000)) MHz"
	else
		# No cpufreq driver on this kernel. Say so rather than printing a
		# guess -- a wrong clock is worse than an absent one.
		echo "CPU Speed: unknown"
	fi
}

# DELIBERATELY UNIMPLEMENTED ON THIS FAMILY, AND THIS IS NOT AN OVERSIGHT.
#
# The Infinity6E board derives its MAC from a 48-bit OTP die ID read from three
# consecutive 16-bit RIU registers, gated on a generation tag that reads 0xF1
# there. Both the tag value and the register addresses were established by
# reading them on Infinity6E hardware. Neither has been read on an Infinity6B0.
#
# The addresses are probably the same -- these families share a RIU layout --
# but "probably" is not good enough for this particular consumer. S03mac
# PERSISTS what this returns into /etc/thingino.json, so a plausible-looking
# read of the wrong registers does not produce a visible error, it produces a
# fleet of cameras that quietly agree on one MAC. An empty answer costs
# nothing here: this board has no ethernet, and its wlan0 address comes from
# the Wi-Fi module's own EFUSE.
#
# To settle it, on a serial console on the running board:
#
#   devmem 0x1F003C00 32     # generation tag; 0xF1 on Infinity6E
#   devmem 0x1F203150 32     # die ID, low  16 bits of each word are the ID
#   devmem 0x1F203154 32
#   devmem 0x1F203158 32
#
# A tag that is neither 0x0000 nor 0xFFFF and three words that are neither all
# zero nor all ones mean the block is real; then this can adopt the Infinity6E
# implementation with the observed tag added to its accepted set.
print_serial_number() {
	return 0
}

print_wiki_line() {
	printf '%s\t%s\t%s\n' "$(print_soc_model)" "$(print_soc_family)" \
		"$(print_soc_architecture)"
}

show_usage() {
	echo "Usage: $0 [-c|-f|-m|-w|-a|-s]
	-m	SoC model
	-f	SoC family
	-w	raw info for wiki
	-a	CPU architecture
	-c	CPU Clocks
	-s	Serial number (unverified on Infinity6B0, prints nothing)
" >&2
}

case "$1" in
	-c) print_soc_clocks ;;
	-f) print_soc_family ;;
	-m) print_soc_model ;;
	-w) print_wiki_line ;;
	-a) print_soc_architecture ;;
	-s) print_serial_number ;;
	"") print_soc_model ;;
	*) show_usage ;;
esac

exit 0
